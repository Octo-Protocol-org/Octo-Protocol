# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Authoritative reference for every variable (purpose, default, required, secret?):
# docs/environment-variables.md — keep this file and that doc in sync; CI fails when a
# variable is undocumented.

# --- Network ---
# Which Stellar network the server operates on: "testnet" or "mainnet".
# On mainnet the server refuses to start unless JWT_SECRET is >= 32 random bytes, MASTER_KEY(_NEXT)
# are high-entropy, no value is a placeholder, and HORIZON_URL / PUBLIC_APP_URL / PUBLIC_API_URL
# use https://.
NETWORK=testnet

# Horizon endpoint (testnet shown). Mainnet: https://horizon.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
# For offline work, the supported mock is the `horizon-mock` service (the `horizon-mock` crate).
# Start it with `docker compose --profile tools up horizon-mock` and point the server at it:
# HORIZON_URL=http://horizon-mock:8000

# --- Horizon resilience ---
# Tune retry/backoff and the circuit breaker for read-only Horizon calls. The defaults shown
# apply when unset; leave these commented out to keep them.
# HORIZON_MAX_ATTEMPTS=3
# HORIZON_BASE_DELAY_MS=200
# HORIZON_MAX_DELAY_MS=5000
# HORIZON_CB_FAILURE_THRESHOLD=5
# HORIZON_CB_RESET_TIMEOUT_SECS=30

# Maximum lifetime for locally built transaction envelopes, in seconds (between 1 and 86400; default 300).
STELLAR_TX_MAX_AGE_SECS=300
# Horizon fee_stats percentile (10,20,30,40,50,60,70,80,90,95,99; default 50).
STELLAR_FEE_PERCENTILE=50
# Maximum per-operation fee returned to signing clients, in stroops (at least 100; default 10000).
STELLAR_FEE_CEILING_STROOPS=10000

# Friendbot (testnet only) — funds new accounts.
FRIENDBOT_URL=https://friendbot.stellar.org

# --- Database ---
# Local dev via docker compose maps Postgres to host port 5433 (avoids a host Postgres on 5432).
DATABASE_URL=postgres://octo:octo@localhost:5433/octo
# Set false when DATABASE_URL is a least-privilege runtime role and migrations run separately via
# `octo-server --migrate-only` as the migrator role (docs/postgres-roles.md). Default true.
# RUN_MIGRATIONS=true
# Pool tuning (defaults shown). DB_STATEMENT_TIMEOUT_SECS=0 disables the per-statement cap.
# DB_MAX_CONNECTIONS=10
# DB_ACQUIRE_TIMEOUT_SECS=30
# DB_IDLE_TIMEOUT_SECS=600
# DB_STATEMENT_TIMEOUT_SECS=30
# `postgres` shares rate limits across replicas; `memory` is per-process only.
# RATE_LIMIT_BACKEND=postgres

# --- Crypto ---
# 32-byte master key (base64) used to AES-256-GCM encrypt the HD seed at rest. Required, secret.
# Generate with: openssl rand -base64 32
# In production this comes from a KMS, not an env var.
MASTER_KEY=

# Optional (commented out by default): next master key for zero-downtime key rotation. Secret.
# Set this alongside MASTER_KEY during a rotation window while `octo-migrate-keys` is running.
# Once the migration tool reports 0 wallets remaining, set MASTER_KEY to this value and unset this.
# Generate with: openssl rand -base64 32
# MASTER_KEY_NEXT=

# 32-byte key (base64) for the tamper-evident audit-log hash chain. Required, secret. Keep it stable:
# changing it makes every existing chain fail `octo-server verify-audit-chain`.
# Generate with: openssl rand -base64 32
AUDIT_CHAIN_KEY=

# Secret used to sign dashboard auth JWTs (HS256). Required, secret. At least 16 bytes.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Optional: previous JWT secret accepted during rotation. Secret. Default: unset.
JWT_SECRET_PREVIOUS=
# JWT claims. Defaults shown.
JWT_ISSUER=octo-api
JWT_AUDIENCE=octo-clients
# Argon2id password-hashing parameters. Defaults shown.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# --- Server ---
# Listen address and log filter. Defaults shown.
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,octo=debug

# --- Docker Compose ---
# Comma-separated compose profiles to enable by default (e.g. "tools" to run the mock Horizon).
# Can also be passed per-invocation: `docker compose --profile tools up horizon-mock`.
# COMPOSE_PROFILES=
# Inside the compose network the server reaches Postgres by service name, not localhost:
# DATABASE_URL=postgres://octo:octo@db:5432/octo

# Base URL of the hosted checkout frontend (Next.js), used to build the `url` field on payment
# links (e.g. https://app.octo.dev/pay/<slug>). No trailing slash.
PUBLIC_APP_URL=http://localhost:3000

# Public base URL of this API, used to reject direct webhook callbacks to its hostname.
PUBLIC_API_URL=http://localhost:8080

# --- Email (Resend) ---
# API key from https://resend.com — required for OTP/welcome/withdrawal emails. Secret.
RESEND_API_KEY=
# Verified sender address, e.g. "Octo <noreply@octohq.org>". Required.
EMAIL_FROM_ADDRESS=

# --- Ingest worker ---
# How often the deposit ingest supervisor polls Horizon for all wallets, and the page size.
# Defaults shown.
INGEST_INTERVAL_SECS=5
INGEST_PAGE_LIMIT=50
# Optional (commented out by default): standby replicas retry the ingest leader lock this often
# (see docs/ha-topology.md). Default: 5.
# INGEST_LOCK_RETRY_SECS=5

# --- Graceful shutdown ---
# Max seconds to drain in-flight HTTP requests and the current ingest tick after SIGTERM/SIGINT
# before force-exiting. Keep below your orchestrator's kill deadline (k8s default: 30s).
SHUTDOWN_DRAIN_TIMEOUT_SECS=25
# Comma-separated browser origins allowed by CORS. Empty denies cross-origin requests.
ALLOWED_ORIGINS=http://localhost:3000
# Optional: comma-separated proxy IPs or CIDRs whose X-Forwarded-For values may be trusted.
# Default: empty (no proxies trusted).
TRUSTED_PROXY_CIDRS=
# Set to 1 only when the public service is HTTPS-only. Default: 0.
ENABLE_HSTS=0

# --- Metrics (Prometheus) ---
# Unset = no /metrics endpoint. Served on its own listener, never on BIND_ADDR.
# A non-loopback address requires METRICS_TOKEN (>= 32 bytes), sent as `Authorization: Bearer`.
# METRICS_BIND_ADDR=127.0.0.1:9898
# METRICS_TOKEN=

# --- Trace export (OpenTelemetry) ---
# Needs a binary built with `--features otel`; unset endpoint = no export. See docs/tracing.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=octo-server
# OTEL_TRACES_SAMPLE_RATIO=1.0
